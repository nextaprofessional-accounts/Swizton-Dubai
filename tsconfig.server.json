{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "outDir": "build",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["tests", "client", "node_modules"]
}
