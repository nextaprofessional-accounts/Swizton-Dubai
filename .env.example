DATABASE_URL=postgresql://swizton:CHANGE_ME@localhost:5432/swizton
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3001
# DEMO_MODE=true enables isolated, in-memory sample data and demo logins only.
DEMO_MODE=false

# Private workbook storage: outside the checkout; restrict to the app service account.
PRIVATE_DATA_DIR=/workspace/private/swizton-workbooks
